# =============================================================
# SOC Dashboard Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — it is gitignored
# =============================================================

# --- Microsoft Entra ID (App Registration) ---
CLIENT_ID=your-app-client-id
CLIENT_SECRET=your-client-secret
TENANT_ID=your-tenant-id

# --- Microsoft Sentinel Workspace ---
SENTINEL_WORKSPACE_ID=your-workspace-id
SENTINEL_WORKSPACE_NAME=your-workspace-name

# --- Azure Resource IDs (for IOC Upload to Sentinel) ---
AZURE_SUBSCRIPTION_ID=your-subscription-guid
AZURE_RESOURCE_GROUP=your-resource-group-name

# --- Optional: Threat Intel API Keys ---
VIRUSTOTAL_API_KEY=
TALOS_API_KEY=
ABUSEIPDB_API_KEY=

# --- Reverse Proxy (upstream SNI proxy with proxy_protocol) ---
# Set to your upstream proxy's IP if traffic arrives via an SNI proxy
# that adds proxy_protocol headers. deploy_lxc.sh uses this to configure
# nginx listen directives with proxy_protocol + set_real_ip_from.
# Leave empty if the dashboard receives direct TLS connections.
UPSTREAM_PROXY_IP=

# --- Flask Settings (local development only — production uses gunicorn via systemd) ---
# Set to 0 in production (disables debugger/reloader)
FLASK_DEBUG=0
# Bind address: use 127.0.0.1 to restrict to local only
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# --- Session & Auth ---
# Random string used to sign session cookies — GENERATE A UNIQUE VALUE:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
# Redirect URI for OAuth (must match Entra app registration)
REDIRECT_URI=https://your-domain.com/auth/callback
# Optional landing URL after Microsoft logout (defaults to https://your-domain.com/logged-out)
POST_LOGOUT_REDIRECT_URI=
# Allowed CORS origins
CORS_ORIGINS=https://your-domain.com
# Comma-separated admin email addresses
ADMIN_USERS=admin@yourdomain.com

# --- Escalation ---
# Comma-separated enabled methods: email, teams_graph, teams_webhook
ESCALATION_METHODS=email
# Email address for escalation notifications (requires Mail.Send permission)
ESCALATION_EMAIL=soc-team@yourdomain.com
# Microsoft Teams channel for escalation notifications (optional)
# Format: teamId/channelId — requires ChannelMessage.Send delegated permission
TEAMS_CHANNEL_ID=
# Microsoft Teams webhook URL (optional, simpler — no Graph permissions needed)
# Supports: Power Automate Workflows, classic Incoming Webhooks
TEAMS_WEBHOOK_URL=

# --- AI & Data Lake (Azure AI Foundry) ---
# Azure OpenAI / AI Foundry endpoint URL
FOUNDRY_ENDPOINT=
# Model deployment name (e.g. gpt-4o)
FOUNDRY_DEPLOYMENT=
# AI Foundry project endpoint (enables MCP agent mode with Sentinel tools)
FOUNDRY_PROJECT_ENDPOINT=
# Optional named agent in Foundry project
FOUNDRY_AGENT_NAME=

# --- Feature Toggles ---
# Set to true to enable, false to disable (all default false)
AI_ASSISTANT_ENABLED=false
KQL_CONSOLE_ENABLED=false
MDTI_ENABLED=true
AI_AUTO_ENRICH_ENABLED=false
AI_AUTO_COMMENT_ENABLED=false
CLOSE_INCIDENT_ENABLED=false
LOGS_ENABLED=false
IOC_UPLOAD_ENABLED=false

# --- Security Copilot Integration ---
# Enable Security Copilot enrichment (on-demand button in incident details)
SECURITY_COPILOT_ENABLED=false
# Enable automatic enrichment of new incidents during hourly refresh
COPILOT_AUTO_ENRICH_ENABLED=false
# Max incidents to auto-enrich per refresh cycle (1-50)
COPILOT_AUTO_ENRICH_MAX_PER_CYCLE=10
# Shared secret for Logic App webhook callbacks (generate a random string)
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
COPILOT_WEBHOOK_SECRET=

# Number of incidents to display in the table (10-1000)
INCIDENTS_DISPLAY_LIMIT=100

# --- Storage Paths (production) ---
# Where to store the Fernet encryption key for DB secrets
CONFIG_KEY_PATH=/var/lib/soc-dashboard/.encryption_key
# Database path
DB_PATH=/var/lib/soc-dashboard/soc_dashboard.db

# --- Autonomous Triage ---
# Master switch. When on, new incidents are triaged during each refresh cycle.
TRIAGE_ENABLED=false
# Post the verdict back to the incident as a comment (<=1000 chars)
TRIAGE_AUTO_COMMENT_ENABLED=false
# Model tier routing: hybrid | always_fast | always_deep
TRIAGE_ROUTING_MODE=hybrid
# Cheap and reasoning deployments. Both fall back to FOUNDRY_DEPLOYMENT if unset,
# so triage works before you create a second deployment.
FOUNDRY_DEPLOYMENT_FAST=
FOUNDRY_DEPLOYMENT_DEEP=
# Max incidents to triage per refresh cycle (1-50)
TRIAGE_MAX_PER_CYCLE=10
# Recent window for behaviour baselines, in days (comparisons use 90d)
TRIAGE_BASELINE_DAYS=7
# Run the deterministic KQL evidence pack before the model reasons
TRIAGE_EVIDENCE_PACK_ENABLED=true
# Directory holding the evidence query pack
TRIAGE_QUERY_DIR=
# Minimum confidence before any containment action may be proposed
TRIAGE_MIN_CONFIDENCE_FOR_ACTIONS=70
# Confidence ceiling applied when evidence coverage is only partial
TRIAGE_PARTIAL_CONFIDENCE_CAP=69
# Allow automatic closure of high-confidence false positives. Leave off until
# you have reviewed a batch of FP verdicts by hand.
TRIAGE_AUTO_CLOSE_FP_ENABLED=false
TRIAGE_AUTO_CLOSE_MIN_CONFIDENCE=90

# --- Gated Response Actions ---
# Global kill switch. Off means no containment action can execute, whatever
# else is set below.
RESPONSE_ACTIONS_ENABLED=false
# Dry run defaults ON: approving an action validates it, resolves the target and
# records 'simulated' WITHOUT calling the API. Turn off deliberately.
RESPONSE_DRY_RUN=true
# Per-action gates. Each also needs the matching Azure permission - see
# docs/AUTONOMOUS_TRIAGE.md section 4.
RESPONSE_ALLOW_ISOLATE_DEVICE=false
RESPONSE_ALLOW_REVOKE_SESSIONS=false
RESPONSE_ALLOW_DISABLE_ACCOUNT=false
RESPONSE_ALLOW_PUSH_IOC=false
RESPONSE_ALLOW_CLOSE_FP=false
# Isolation type: Full | Selective
RESPONSE_ISOLATION_TYPE=Full
# Confidence stamped on indicators published to Sentinel TI (0-100)
RESPONSE_IOC_CONFIDENCE=75
# Graph determination used when closing a false positive
RESPONSE_FP_DETERMINATION=notMalicious
